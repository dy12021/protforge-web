# 蛋白计算平台 环境变量示例
#
# 用法：复制成同目录下的 .env（.env 已被 .gitignore 挡住，不会进仓库），
#       然后把需要的值填上。start.bat 会在拉起服务前载入它。
#
# 纪律：
#   1. 这里的每一行左边是变量名，右边留空 = 用代码里的默认值。
#   2. 值里不要加引号，不要写行尾注释（cmd 的 for /f 不会去掉它们）。
#   3. 任何密钥都不要写进本文件以外的任何仓库文件，也不要提交 .env 本身。
#   4. 代码只从进程环境读变量 —— 不起 start.bat 而是自己手工拉服务时，
#      这些变量不会自动生效，得先在 PowerShell 里 $env:NAME = "value"。

# ---------------------------------------------------------------- 数据盘

# 数据盘根。**缺省是仓库旁边的 data\**（跟着代码走）。
# 要把数据挪到别的盘（数据与代码不同盘的老规矩）就指过去：
# PROTFORGE_WEB_DATA_ROOT=D:\some-disk\protforge-web-data

# 数据库路径。缺省 <PROTFORGE_WEB_DATA_ROOT>\web.db
# 指向别处时用绝对路径：
# PROTFORGE_WEB_DB=D:\some-disk\protforge-web-data\web.db

# ---------------------------------------------------------------- 内部通道

# 内部 API 基址，被 agent 和管理员面板用来回调。
# **不要带 /api 前缀** —— agent 侧拼的是 <基址>/api/internal/agent/...，
# 带了会变成双斜杠的 404。缺省 http://127.0.0.1:8475
PROTFORGE_WEB_INTERNAL=http://127.0.0.1:8475

# ---------------------------------------------------------------- 技能与数据区

# 服务端（FastAPI）读技能目录用的。
# **缺省是旁边那个技能仓的 skills\**（../protforge/skills）——技能仓是另一个
# 仓库（github.com/dy12021/protforge），clone 在旁边就能用。
# PROTFORGE_WEB_SKILLS_DIR=D:\path\to\protforge\skills

# agent（Node）读技能目录用的，与上面同一个目录
# （不设时 agent 也会认上面那个变量）。
# PROTFORGE_SKILLS_DIR=D:\path\to\protforge\skills

# ProtForge 的只读数据区。本项目只引用不搬动产物。
# 缺省是旁边那个技能仓的 data\
# PROTFORGE_DATA=D:\path\to\protforge\data

# ---------------------------------------------------------------- 调度器

# 后台工种总开关。**生产必须设为 1**。
#
# 一个开关同时管三样：调度器（拉起 agent）、打包器（产物打 zip）、
# 清理器（按保留期回收磁盘）。它们都跟着内部 API 进程(8475)起。
# 不打开的话：任务提交后永远停在「排队中」，不会有 agent 被拉起来。
#
# 代码里默认关闭只有一个理由：测试用临时库时，这三样不该真去干活
# （起 node 进程、压 zip）。
PROTFORGE_WEB_WORKERS=1

# node 可执行文件。PATH 上没有 node 时填绝对路径。
# 缺省 node
# PROTFORGE_WEB_NODE=C:\Program Files\nodejs\node.exe

# agent 入口脚本。缺省 <代码目录>\agent\run.mjs，一般不用改。
# PROTFORGE_WEB_AGENT_SCRIPT=<仓库>\agent\run.mjs

# 并发任务上限。缺省按 GPU 数推断，推断不出则为 1。
# 一张卡同时只跑一个计算任务时保持默认。
# PROTFORGE_WEB_MAX_CONCURRENCY=1

# ---------------------------------------------------------------- 初始管理员

# 首次启动时用这一对变量自动创建管理员（用户名 + 口令）。
# 只有两个都填了才会创建，且**同名用户已存在时绝不覆盖**——
# 覆盖等于用一次重启把现有人踢出系统。
# 建好之后这两行可以留着（不会重复创建），也可以清掉。
PROTFORGE_ADMIN_USER=admin
PROTFORGE_ADMIN_PASSWORD=

# ---------------------------------------------------------------- 联网搜索

# MCP 搜索用的 key。**留空不报错**，只是 agent 不能联网查资料。
MINIMAX_API_KEY=

# 同上。缺省 https://api.minimax.cn
# MINIMAX_API_HOST=https://api.minimax.cn

# ---------------------------------------------------------------- 以下不要手工设

# PROTFORGE_TASK_ID / PROTFORGE_AGENT_TOKEN / PROTFORGE_WORK_DIR
#   这三个由调度器 spawn agent 时注入，手工设的 token 会被判为无效。

# LLM 模型与密钥（base_url https://api.minimax.cn/v1，模型 MiniMax-M3.1-Flash-Preview）
#   **本仓库当前没有任何代码读 LLM 相关环境变量** —— 模型与密钥走 pi 自己的
#   agent 目录（%USERPROFILE%\.pi\agent\ 下的 auth.json / models-store.json）。
#   接线方式尚未联调确认，所以这里**故意不提供变量名**：先别猜着填，
#   等调度器与凭据传递方式定下来再补。
